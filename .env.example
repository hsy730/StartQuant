# 复制为 .env 后按需修改；未设置的项使用 backend/core/settings.py 中的默认值
# 环境变量名与 Settings 字段同名，大小写不敏感

# ---- 性能档位 ----
# low : 低性能笔记本（默认；4 线程取数，CPU 密集任务 2 线程）
# mid : 台式机多核（8 线程取数，CPU 密集任务 8 线程，挖掘链路按 CPU 核数自动推导）
PERFORMANCE_PROFILE=low

# ---- 单项覆盖（可选）----
# 档位只决定默认值，下面任一项写出来就会覆盖档位设定。
# 注意：akshare 的 JS 签名引擎 py_mini_racer 不是线程安全的：
# 15 线程冷缓存批量取数在 160 只股票上实测会随机硬崩溃（exit 0x80000003），
# 需要稳定批量拉数时把取数线程压到 1~4；缓存已预热时可调高。
# DATA_FETCH_MAX_WORKERS=4
# INDUSTRY_FETCH_MAX_WORKERS=4
# FACTOR_CALC_MAX_WORKERS=4
# ANALYSIS_MAX_WORKERS=2
# VALIDATION_MAX_WORKERS=2
# PREPROCESSING_MAX_WORKERS=2
# PREPROCESSING_STOCK_MAX_WORKERS=4
# MINING_PRECOMPUTE_MAX_WORKERS=2   # 0 = CPU 核数
# MINING_STOCK_POOL_MAX_WORKERS=2   # 0 = min(CPU, 8)
